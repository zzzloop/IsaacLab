<robot name="cube">
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <material name="cube_material">
                <color rgba="1 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <surface>
                <mu1>1.8</mu1> 
                <mu2>1.8</mu2>
                <friction>
                    <ode>
                        <mu>2</mu>
                        <mu2>1.8</mu2>
                    </ode>
                </friction>
                <restitution>
                    <coefficient>0.1</coefficient>
                </restitution>
            </surface>
        </collision>
    </link>
</robot>

